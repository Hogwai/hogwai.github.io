---
import "../styles/global.css";
import { ClientRouter } from 'astro:transitions';
import { getLocalePath, getAlternateUrl, getOtherLang, type Lang } from "../i18n/utils";
import { defaultLang } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  lang?: Lang;
}

const { title, description = "Heap of Hogwai", image, ogType = "website", publishedTime, modifiedTime, tags, lang = defaultLang } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const otherLang = getOtherLang(lang);
const alternateURL = new URL(getAlternateUrl(Astro.url, otherLang), Astro.site);
const xDefaultURL = lang === defaultLang ? canonicalURL : alternateURL;
const defaultOGImage = (() => {
  let p = Astro.url.pathname.replace(/\/$/, '') || '/home';
  if (p === '/fr') p = '/fr/home';
  // Tag detail pages fall back to the generic tags OG image
  if (/^\/tags\//.test(p)) p = '/tags';
  if (/^\/fr\/tags\//.test(p)) p = '/fr/tags';
  // 404 page — favicon fallback
  if (p === '/404') return '/favicon.png';
  return `/og${p}.png`;
})();
const ogImage = image ?? defaultOGImage;
const imageURL = new URL(ogImage, Astro.site).href;
const siteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Heap of Hogwai",
  url: Astro.site?.href ?? "https://hogwai.dev",
  inLanguage: lang === "fr" ? "fr-FR" : "en-GB",
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="Bp-Nwd3CbHnQjYafsGPLBcIS5qHvfJIcvhc9Zaej6nE" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={otherLang} href={alternateURL} />
    <link rel="alternate" hreflang="x-default" href={xDefaultURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta http-equiv="content-language" content={lang === "fr" ? "fr-FR" : "en-US"} />
    <meta name="author" content="Lilian" />
    <link rel="author" href={`${getLocalePath(lang)}/about`} />
    <meta name="theme-color" content="#2563eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e3a5f" media="(prefers-color-scheme: dark)" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Heap of Hogwai" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "fr_FR" : "en_US"} />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    {imageURL && <meta property="og:image" content={imageURL} />}
    {imageURL && <meta property="og:image:alt" content={title} />}

    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    {imageURL && <meta name="twitter:image:alt" content={title} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Heap of Hogwai RSS Feed"
      href={`${getLocalePath(lang)}/rss.xml`}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://cloud.umami.is" crossorigin />
    <link rel="dns-prefetch" href="https://cloud.umami.is" />
    <link rel="manifest" href="/manifest.json" />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} is:inline />

    <slot name="head" />

    <script is:inline>
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js");
        });
      }
    </script>
    <script is:inline>
      (function () {
        var defined = "preferred-lang";
        var stored;
        try { stored = localStorage.getItem(defined); } catch (e) {}
        var target = stored || (navigator.language.startsWith("fr") ? "fr" : "en");
        var path = location.pathname;
        // Skip non-content paths
        if (/\.(xml|json)$/.test(path) || path.startsWith("/rss")) return;
        var isFr = /^\/fr(\/|$)/.test(path);
        var currentLang = isFr ? "fr" : "en";
        if (target === currentLang) return;
        var newPath;
        if (target === "fr") {
          newPath = path === "/" ? "/fr/" : "/fr" + path;
        } else {
          newPath = path.replace(/^\/fr(\/|$)/, "/") || "/";
        }
        location.replace(newPath);
      })();
    </script>
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="be4da73f-7653-4f79-8c0e-8e517de6dbba"
        />
      )
    }

    <ClientRouter />

    <style is:global>
      html {
        scroll-padding-top: 5rem;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent-600 focus:text-white focus:rounded">
      Skip to content
    </a>
    <slot />
    <script is:inline>
      (function () {
        document.querySelectorAll("h2").forEach(function (heading) {
          if (heading.textContent.trim() !== "References") return;
          var list = heading.nextElementSibling;
          while (list && list.tagName !== "UL" && list.tagName !== "OL") {
            list = list.nextElementSibling;
          }
          if (!list) return;
          list.querySelectorAll("a[href]").forEach(function (link) {
            var url = new URL(link.href, window.location.href);
            if (!/^https?:$/.test(url.protocol) || url.origin === window.location.origin) return;
            link.setAttribute("target", "_blank");
            link.setAttribute("rel", "noopener noreferrer");
          });
        });

        var CITE_PREFIX = "ref-src-";
        var citationCounts = {};
        document.querySelectorAll("sup > a[href^=\"#fn\"]").forEach(function (link) {
          var href = link.getAttribute("href");
          if (!href || href === "#") return;
          var targetId = href.slice(1);
          if (!/^fn\d+$/.test(targetId)) return;
          var target = document.getElementById(targetId);
          if (!target) return;
          var sup = link.closest("sup");
          if (!sup) return;
          var occurrence = (citationCounts[targetId] || 0) + 1;
          citationCounts[targetId] = occurrence;
          var citationId = CITE_PREFIX + targetId + "-" + occurrence;
          sup.id = citationId;
          var li = target.closest("li");
          if (!li) return;
          var backLink = document.createElement("a");
          backLink.href = "#" + citationId;
          backLink.className = "ref-back";
          backLink.setAttribute("aria-label", "Return to citation");
          backLink.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10a5 5 0 0 1 5 5v1"></path></svg>';
          li.appendChild(backLink);
        });
      })();
    </script>



  </body>
</html>
